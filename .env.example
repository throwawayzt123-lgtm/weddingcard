# ---------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
# NEVER commit ".env" to GitHub (it is already in .gitignore).
# ---------------------------------------------------------------

# --- Database (Neon) -------------------------------------------
# In Neon: Dashboard -> your project -> "Connect".
# DATABASE_URL = the POOLED connection string (host contains "-pooler")
# DIRECT_URL   = the DIRECT connection string (toggle "Connection pooling" off)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------
# A long random secret used to sign login cookies.
# Generate one in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
# Lets "npm start" work on your own computer. Vercel sets this automatically.
AUTH_TRUST_HOST=true

# --- First admin account (created by "npm run db:seed") --------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Owner"

# Password for the demo client account the seed creates (username: demo).
DEMO_CLIENT_PASSWORD="demo12345"
# Set to false on the LIVE website so the seed does not create the demo customer/invitation.
# SEED_DEMO=false

# --- Public site URL -------------------------------------------
# Used to build invitation links and WhatsApp messages.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudinary (needed from Phase 5: photo & music uploads) ----
# Cloudinary Dashboard -> "Product Environment" -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
